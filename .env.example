# Use: node --env-file=.env scripts/serve.mjs
PORT=4173
# Optional remote MCP. HTTPS, exact host allowlist, explicit read-only tool allowlist.
MCP_ALLOWED_HOSTS=your-trusted-host.example
MCP_SERVERS_JSON=[]
# Example: [{"id":"research","name":"Research","url":"https://your-trusted-host.example/mcp","allowedTools":["search_evidence"],"tokenEnv":"RESEARCH_MCP_TOKEN"}]
# RESEARCH_MCP_TOKEN=
# Optional generic model adapter. Receives structured JSON, returns {"text":"..."}.
# MODEL_ENDPOINT=https://your-trusted-host.example/generate
# MODEL_ALLOWED_HOSTS=your-trusted-host.example
# MODEL_TOKEN=

# DeepSeek native mode (server-side only; obtain your own key, never put it in HTML):
# MODEL_PROVIDER=deepseek
# MODEL_ID=deepseek-flash
# MODEL_DATA_SCOPE=demo-only
# MODEL_ENDPOINT=https://api.deepseek.com/chat/completions
# MODEL_ALLOWED_HOSTS=api.deepseek.com
# MODEL_TOKEN=
